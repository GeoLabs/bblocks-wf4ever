        bblocks:Schema ;
    rdfs:label "wfprov:WorkflowEngine" ;
    dct:abstract "A software agent that executes workflows. The WorkflowEngine is responsible for enacting workflow and process executions, managing the execution environment and resources."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
