<bblocks://ogc.bbr.wf4ever.ro.ResearchObject> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "ro:ResearchObject" ;
    dct:abstract "A Research Object that bundles resources, data, methods, and contextual information. It provides a structured way to package research outputs with their provenance, making them portable, shareable, and preservable."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
