<bblocks://ogc.bbr.wf4ever.wfprov> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Workflow Provenance Ontology (wfprov)" ;
    dct:abstract "The Workflow Provenance ontology (wfprov) extends PROV-O to describe workflow execution traces, linking workflow runs to their descriptions."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
