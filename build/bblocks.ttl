<bblocks://ogc.bbr.wf4ever.ro.FolderEntry> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "ro:FolderEntry" ;
    dct:abstract "An entry within a folder that associates a name with a resource. FolderEntries provide the mapping between folder paths and actual resources, similar to filesystem directory entries."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
