<bblocks://ogc.bbr.wf4ever.wfdesc.Process> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "wfdesc:Process" ;
    dct:abstract "A computational process or task in a workflow. Processes have inputs, outputs, and perform computations. This is the base class for atomic processes and composite Workflows."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
