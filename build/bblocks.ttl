<bblocks://ogc.bbr.wf4ever.wfdesc> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "Workflow Description Ontology (wfdesc)" ;
    dct:abstract "The Workflow Description ontology (wfdesc) describes the structure of workflows, including processes, inputs, outputs, and data flow."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-11-07T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
