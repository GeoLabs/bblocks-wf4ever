<bblocks://ogc.bbr.wf4ever.ro.AggregatedAnnotation> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "ro:AggregatedAnnotation" ;
    dct:abstract "An annotation about resources within a Research Object. Annotations provide additional metadata, provenance information, or contextual details about aggregated resources, stored as part of the Research Object itself."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-11-07T00:00:00+00:00"^^xsd:dateTime ;
