        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "ro:Folder" ;
    dct:abstract "A folder that organizes resources within a Research Object. Folders provide hierarchical structure, similar to filesystem directories, allowing logical grouping of related resources."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
