<bblocks://ogc.bbr.wf4ever.wfprov.Artifact> a skos:Concept,
        dcat:Dataset,
        bblocks:Schema ;
    rdfs:label "wfprov:Artifact" ;
    dct:abstract "A data entity that was used as input or generated as output during a workflow execution. Artifacts are the data products consumed or produced by process runs."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
